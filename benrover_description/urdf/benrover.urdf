<!--

  Squelette générique de URDF pour un rover 6 roues a suspension rocker-bogie
  (type Mars rover : Sojourner / Spirit-Opportunity / Curiosity).

  VERSION ADAPTEE POUR GAZEBO GARDEN (gz-sim7), PAS Gazebo Classic :
    - Le mesh manquant (base_link.STL) est remplace par la primitive box
      deja prevue en repli dans le fichier original.
    - Les 4 plugins <gazebo><plugin filename="libgazebo_ros_*.so"> (Classic)
      ont ete remplaces par leurs equivalents gz-sim :
        libgazebo_ros_diff_drive.so           -> gz-sim-diff-drive-system
        libgazebo_ros_joint_state_publisher.so -> gz-sim-joint-state-publisher-system
        libgazebo_ros_ray_sensor.so (lidar)     -> <sensor type="gpu_lidar">
        libgazebo_ros_imu_sensor.so             -> <sensor type="imu">
    - IMPORTANT : ces plugins/capteurs gz-sim publient uniquement sur le bus
      Gazebo Transport, pas directement sur des topics ROS 2. Un pont
      ros_gz_bridge (fichier de config separe) sera necessaire pour exposer
      /cmd_vel, /joint_states, /scan, /imu cote ROS 2. C'est l'etape suivante,
      pas geree dans ce fichier.
    - Objectif de cette version : permettre un spawn + un premier test de
      /cmd_vel et /joint_states, PAS representer fidelement BenRover.
      Dimensions/masses restent des valeurs generiques a affiner plus tard
      avec le vrai CAO SolidWorks (mates + export SW2URDF).
    - Les joints de direction (steer_front_*/steer_rear_*) ne sont PAS
      pilotes par ce plugin diff_drive (qui ne commande que les joints de
      roue continuous) : ils restent figes a 0 pour cette premiere version.
      Un controleur de direction pourra etre ajoute plus tard sans toucher
      a cette base.
-->
<robot name="benrover_skeleton">
<material name="chassis_grey">
<color rgba="0.6 0.6 0.6 1.0"/>
</material>
<material name="rocker_dark">
<color rgba="0.25 0.25 0.25 1.0"/>
</material>
<material name="wheel_black">
<color rgba="0.05 0.05 0.05 1.0"/>
</material>
<!--
 ===================== CHASSIS ===================== 
-->
<link name="base_link">
<inertial>
<origin xyz="0 0 0" rpy="0 0 0"/>
<mass value="12.0"/>
<inertia ixx="0.15" ixy="0" ixz="0" iyy="0.20" iyz="0" izz="0.25"/>
</inertial>
<visual>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<!-- Mesh STL non disponible pour l'instant -> primitive de repli en attendant le vrai CAO -->
<box size="0.5 0.35 0.15"/>
</geometry>
<material name="chassis_grey"/>
</visual>
<collision>
<origin xyz="0 0 0" rpy="0 0 0"/>
<geometry>
<box size="0.5 0.35 0.15"/>
</geometry>
</collision>
</link>
<!--
 ===================== COTE GAUCHE ===================== 
-->
<!-- Rocker gauche : bras principal de suspension -->
<link name="rocker_left">
<inertial>
<origin xyz="0 0 -0.02" rpy="0 0 0"/>
<mass value="1.2"/>
<inertia ixx="0.01" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
</inertial>
<visual>
<origin xyz="0 0 -0.02" rpy="0 0 0"/>
<geometry>
<box size="0.40 0.04 0.04"/>
</geometry>
<material name="rocker_dark"/>
</visual>
<collision>
<origin xyz="0 0 -0.02" rpy="0 0 0"/>
<geometry>
<box size="0.40 0.04 0.04"/>
</geometry>
</collision>
</link>
<joint name="rocker_left_joint" type="revolute">
<!--
 Pivot du rocker sur le chassis. Axe Y = bascule avant/arriere. 
-->
<origin xyz="0.05 0.20 0.0" rpy="0 0 0"/>
<parent link="base_link"/>
<child link="rocker_left"/>
<axis xyz="0 1 0"/>
<limit lower="-0.6" upper="0.6" effort="50" velocity="1.0"/>
<dynamics damping="0.2" friction="0.1"/>
</joint>
<!--
 Point d'ancrage possible pour la barre differentielle (voir note en tete de fichier) 
-->
<!--
 Bogie gauche : porte les roues centrale et arriere 
-->
<link name="bogie_left">
<inertial>
<origin xyz="0 0 -0.02" rpy="0 0 0"/>
<mass value="0.8"/>
<inertia ixx="0.006" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
</inertial>
<visual>
<origin xyz="0 0 -0.02" rpy="0 0 0"/>
<geometry>
<box size="0.26 0.04 0.04"/>
</geometry>
<material name="rocker_dark"/>
</visual>
<collision>
<origin xyz="0 0 -0.02" rpy="0 0 0"/>
<geometry>
<box size="0.26 0.04 0.04"/>
</geometry>
</collision>
</link>
<joint name="bogie_left_joint" type="revolute">
<!-- Pivot du bogie en arriere du pivot du rocker. -->
<origin xyz="-0.20 0 -0.04" rpy="0 0 0"/>
<parent link="rocker_left"/>
<child link="bogie_left"/>
<axis xyz="0 1 0"/>
<limit lower="-0.4" upper="0.4" effort="30" velocity="1.0"/>
<dynamics damping="0.2" friction="0.1"/>
</joint>
<!-- Direction avant gauche -->
<link name="steer_front_left">
<inertial>
<mass value="0.1"/>
<inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
</inertial>
</link>
<joint name="steer_front_left_joint" type="revolute">
<!-- Roue avant en avant du pivot du rocker. -->
<origin xyz="0.20 0 -0.06" rpy="0 0 0"/>
<parent link="rocker_left"/>
<child link="steer_front_left"/>
<axis xyz="0 0 1"/>
<limit lower="-0.6" upper="0.6" effort="10" velocity="2.0"/>
<dynamics damping="0.1" friction="0.05"/>
</joint>
<!-- Roue avant gauche -->
<link name="wheel_front_left">
<inertial>
<mass value="0.6"/>
<inertia ixx="0.002" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/>
</inertial>
<visual>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
<material name="wheel_black"/>
</visual>
<collision>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
</collision>
</link>
<joint name="wheel_front_left_joint" type="continuous">
<origin xyz="0 0 0" rpy="0 0 0"/>
<parent link="steer_front_left"/>
<child link="wheel_front_left"/>
<axis xyz="0 1 0"/>
<dynamics damping="0.05" friction="0.02"/>
</joint>
<!-- Roue centrale gauche (pas de direction) -->
<link name="wheel_middle_left">
<inertial>
<mass value="0.6"/>
<inertia ixx="0.002" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/>
</inertial>
<visual>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
<material name="wheel_black"/>
</visual>
<collision>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
</collision>
</link>
<joint name="wheel_middle_left_joint" type="continuous">
<!-- Roue centrale en avant du pivot du bogie. -->
<origin xyz="0.12 0 -0.08" rpy="0 0 0"/>
<parent link="bogie_left"/>
<child link="wheel_middle_left"/>
<axis xyz="0 1 0"/>
<dynamics damping="0.05" friction="0.02"/>
</joint>
<!-- Direction arriere gauche -->
<link name="steer_rear_left">
<inertial>
<mass value="0.1"/>
<inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
</inertial>
</link>
<joint name="steer_rear_left_joint" type="revolute">
<!-- Roue arriere en arriere du pivot du bogie. -->
<origin xyz="-0.12 0 -0.08" rpy="0 0 0"/>
<parent link="bogie_left"/>
<child link="steer_rear_left"/>
<axis xyz="0 0 1"/>
<limit lower="-0.6" upper="0.6" effort="10" velocity="2.0"/>
<dynamics damping="0.1" friction="0.05"/>
</joint>
<!-- Roue arriere gauche -->
<link name="wheel_rear_left">
<inertial>
<mass value="0.6"/>
<inertia ixx="0.002" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/>
</inertial>
<visual>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
<material name="wheel_black"/>
</visual>
<collision>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
</collision>
</link>
<joint name="wheel_rear_left_joint" type="continuous">
<origin xyz="0 0 0" rpy="0 0 0"/>
<parent link="steer_rear_left"/>
<child link="wheel_rear_left"/>
<axis xyz="0 1 0"/>
<dynamics damping="0.05" friction="0.02"/>
</joint>
<!--
 ===================== COTE DROIT (miroir) ===================== 
-->
<link name="rocker_right">
<inertial>
<origin xyz="0.15 0 -0.02" rpy="0 0 0"/>
<mass value="1.2"/>
<inertia ixx="0.01" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
</inertial>
<visual>
<origin xyz="0 0 -0.02" rpy="0 0 0"/>
<geometry>
<box size="0.40 0.04 0.04"/>
</geometry>
<material name="rocker_dark"/>
</visual>
<collision>
<origin xyz="0 0 -0.02" rpy="0 0 0"/>
<geometry>
<box size="0.40 0.04 0.04"/>
</geometry>
</collision>
</link>
<joint name="rocker_right_joint" type="revolute">
<origin xyz="0.05 -0.20 0.0" rpy="0 0 0"/>
<parent link="base_link"/>
<child link="rocker_right"/>
<axis xyz="0 1 0"/>
<limit lower="-0.6" upper="0.6" effort="50" velocity="1.0"/>
<dynamics damping="0.2" friction="0.1"/>
</joint>
<link name="bogie_right">
<inertial>
<origin xyz="0 0 -0.02" rpy="0 0 0"/>
<mass value="0.8"/>
<inertia ixx="0.006" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
</inertial>
<visual>
<origin xyz="0 0 -0.02" rpy="0 0 0"/>
<geometry>
<box size="0.26 0.04 0.04"/>
</geometry>
<material name="rocker_dark"/>
</visual>
<collision>
<origin xyz="0 0 -0.02" rpy="0 0 0"/>
<geometry>
<box size="0.26 0.04 0.04"/>
</geometry>
</collision>
</link>
<joint name="bogie_right_joint" type="revolute">
<origin xyz="-0.20 0 -0.04" rpy="0 0 0"/>
<parent link="rocker_right"/>
<child link="bogie_right"/>
<axis xyz="0 1 0"/>
<limit lower="-0.4" upper="0.4" effort="30" velocity="1.0"/>
<dynamics damping="0.2" friction="0.1"/>
</joint>
<link name="steer_front_right">
<inertial>
<mass value="0.1"/>
<inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
</inertial>
</link>
<joint name="steer_front_right_joint" type="revolute">
<origin xyz="0.20 0 -0.06" rpy="0 0 0"/>
<parent link="rocker_right"/>
<child link="steer_front_right"/>
<axis xyz="0 0 1"/>
<limit lower="-0.6" upper="0.6" effort="10" velocity="2.0"/>
<dynamics damping="0.1" friction="0.05"/>
</joint>
<link name="wheel_front_right">
<inertial>
<mass value="0.6"/>
<inertia ixx="0.002" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/>
</inertial>
<visual>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
<material name="wheel_black"/>
</visual>
<collision>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
</collision>
</link>
<joint name="wheel_front_right_joint" type="continuous">
<origin xyz="0 0 0" rpy="0 0 0"/>
<parent link="steer_front_right"/>
<child link="wheel_front_right"/>
<axis xyz="0 1 0"/>
<dynamics damping="0.05" friction="0.02"/>
</joint>
<link name="wheel_middle_right">
<inertial>
<mass value="0.6"/>
<inertia ixx="0.002" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/>
</inertial>
<visual>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
<material name="wheel_black"/>
</visual>
<collision>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
</collision>
</link>
<joint name="wheel_middle_right_joint" type="continuous">
<origin xyz="0.12 0 -0.08" rpy="0 0 0"/>
<parent link="bogie_right"/>
<child link="wheel_middle_right"/>
<axis xyz="0 1 0"/>
<dynamics damping="0.05" friction="0.02"/>
</joint>
<link name="steer_rear_right">
<inertial>
<mass value="0.1"/>
<inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
</inertial>
</link>
<joint name="steer_rear_right_joint" type="revolute">
<origin xyz="-0.12 0 -0.08" rpy="0 0 0"/>
<parent link="bogie_right"/>
<child link="steer_rear_right"/>
<axis xyz="0 0 1"/>
<limit lower="-0.6" upper="0.6" effort="10" velocity="2.0"/>
<dynamics damping="0.1" friction="0.05"/>
</joint>
<link name="wheel_rear_right">
<inertial>
<mass value="0.6"/>
<inertia ixx="0.002" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.002"/>
</inertial>
<visual>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
<material name="wheel_black"/>
</visual>
<collision>
<origin xyz="0 0 0" rpy="1.5708 0 0"/>
<geometry>
<cylinder radius="0.09" length="0.06"/>
</geometry>
</collision>
</link>
<joint name="wheel_rear_right_joint" type="continuous">
<origin xyz="0 0 0" rpy="0 0 0"/>
<parent link="steer_rear_right"/>
<child link="wheel_rear_right"/>
<axis xyz="0 1 0"/>
<dynamics damping="0.05" friction="0.02"/>
</joint>
<!--
 ===================== CAPTEURS =====================
       Positions placeholder : a ajuster une fois les vraies cotes connues.
       Syntaxe gz-sim native (pas de plugin par capteur individuel comme en
       Classic) : le <topic> definit le nom sur le bus Gazebo Transport.
       Necessite que le monde charge le system "gz-sim-sensors-system"
       (a ajouter au niveau du world SDF, pas ici) pour que ces capteurs
       soient effectivement simules.
  
-->
<!-- LIDAR : place au sommet du chassis, centre -->
<link name="lidar_link">
<inertial>
<mass value="0.15"/>
<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
</inertial>
<visual>
<geometry>
<cylinder radius="0.04" length="0.05"/>
</geometry>
<material name="rocker_dark"/>
</visual>
<collision>
<geometry>
<cylinder radius="0.04" length="0.05"/>
</geometry>
</collision>
</link>
<joint name="lidar_joint" type="fixed">
<origin xyz="0 0 0.15" rpy="0 0 0"/>
<parent link="base_link"/>
<child link="lidar_link"/>
</joint>
<gazebo reference="lidar_link">
<sensor name="lidar_sensor" type="gpu_lidar">
<topic>scan</topic>
<update_rate>10</update_rate>
<always_on>true</always_on>
<visualize>false</visualize>
<lidar>
<scan>
<horizontal>
<samples>360</samples>
<resolution>1</resolution>
<min_angle>-3.14159</min_angle>
<max_angle>3.14159</max_angle>
</horizontal>
</scan>
<range>
<min>0.10</min>
<max>12.0</max>
<resolution>0.01</resolution>
</range>
</lidar>
</sensor>
</gazebo>
<!-- IMU : place au centre du chassis -->
<link name="imu_link">
<inertial>
<mass value="0.05"/>
<inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
</inertial>
</link>
<joint name="imu_joint" type="fixed">
<origin xyz="0 0 0.02" rpy="0 0 0"/>
<parent link="base_link"/>
<child link="imu_link"/>
</joint>
<gazebo reference="imu_link">
<sensor name="imu_sensor" type="imu">
<topic>imu</topic>
<always_on>true</always_on>
<update_rate>100</update_rate>
</sensor>
</gazebo>
<!--
 ===================== PLUGINS GAZEBO SIM (Garden / gz-sim7) =====================
       Remplacent les plugins Gazebo Classic du fichier original. Publient
       sur le bus Gazebo Transport : un pont ros_gz_bridge (a configurer
       separement) sera necessaire pour exposer ces topics cote ROS 2.
  
-->
<!--
 Encodeurs de roues + articulations -> etat reel (physique) sur le bus gz.
       Remplace le joint_state_publisher_gui (qui ne fait que rejouer des
       valeurs arbitraires) : ici les positions/vitesses viennent du moteur
       physique de Gazebo. 
-->
<gazebo>
<plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
<topic>joint_states</topic>
<update_rate>50</update_rate>
<joint_name>rocker_left_joint</joint_name>
<joint_name>bogie_left_joint</joint_name>
<joint_name>steer_front_left_joint</joint_name>
<joint_name>steer_rear_left_joint</joint_name>
<joint_name>wheel_front_left_joint</joint_name>
<joint_name>wheel_middle_left_joint</joint_name>
<joint_name>wheel_rear_left_joint</joint_name>
<joint_name>rocker_right_joint</joint_name>
<joint_name>bogie_right_joint</joint_name>
<joint_name>steer_front_right_joint</joint_name>
<joint_name>steer_rear_right_joint</joint_name>
<joint_name>wheel_front_right_joint</joint_name>
<joint_name>wheel_middle_right_joint</joint_name>
<joint_name>wheel_rear_right_joint</joint_name>
</plugin>
</gazebo>
<!--
 Controle differentiel -> repond a /cmd_vel (via le pont ros_gz_bridge).
       Un cote = les 3 roues gauches, l'autre = les 3 roues droites
       (entrainement type skid/diff sur 6 roues, courant sur les rovers a
       suspension rocker-bogie). Seuls les joints "wheel_*" (continuous)
       sont pilotes ici ; les joints "steer_*" restent figes pour cette
       premiere version (voir note en tete de fichier). 
-->
<gazebo>
<plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
<left_joint>wheel_front_left_joint</left_joint>
<left_joint>wheel_middle_left_joint</left_joint>
<left_joint>wheel_rear_left_joint</left_joint>
<right_joint>wheel_front_right_joint</right_joint>
<right_joint>wheel_middle_right_joint</right_joint>
<right_joint>wheel_rear_right_joint</right_joint>
<wheel_separation>0.40</wheel_separation>
<wheel_radius>0.09</wheel_radius>
<odom_publish_frequency>30</odom_publish_frequency>
<topic>cmd_vel</topic>
<odom_topic>odom</odom_topic>
<frame_id>odom</frame_id>
<child_frame_id>base_link</child_frame_id>
</plugin>
</gazebo>
</robot>
